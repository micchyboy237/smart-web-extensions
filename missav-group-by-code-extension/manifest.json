{
  "manifest_version": 3,
  "name": "MissAV Group by Code",
  "version": "2.0.1",
  "description": "Groups MissAV search results by JAV code with enhanced UI and results panel",
  "permissions": [],
  "host_permissions": ["https://missav.ws/*"],
  "content_scripts": [
    {
      "matches": ["https://missav.ws/*"],
      "js": [
        "js/config.js",
        "js/state.js",
        "js/extractor.js",
        "js/filter.js",
        "js/ui.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MissAV Group by Code"
  }
}
