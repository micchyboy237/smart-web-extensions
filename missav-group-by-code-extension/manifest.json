{
  "manifest_version": 3,
  "name": "MissAV Group by Code",
  "version": "1.0.2",
  "description": "Groups MissAV search results by JAV code with search and filter capabilities",
  "permissions": [],
  "host_permissions": ["https://missav.ws/*"],
  "content_scripts": [
    {
      "matches": ["https://missav.ws/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MissAV Group by Code"
  }
}
