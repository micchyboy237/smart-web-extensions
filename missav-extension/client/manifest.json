{
  "manifest_version": 3,
  "name": "MissAV Smart Search",
  "version": "2.0",
  "description": "Smart search and filter videos with AI-powered recommendations",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://192.168.68.30:8000/*"],
  "action": {
    "default_title": "MissAV Smart Search"
  },
  "content_scripts": [
    {
      "matches": ["https://missav.ws/*"],
      "js": ["utils.js", "db.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
