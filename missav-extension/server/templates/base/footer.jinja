
<footer class="border-top mt-5 py-4" style="border-color: rgba(255,255,255,0.1) !important;">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-6 text-muted small">
                <i class="bi bi-c-circle"></i> 2024 MissAV Smart Search API
                <span class="mx-2">•</span>
                <span id="server-version">v1.0.0</span>
            </div>
            <div class="col-md-6 text-md-end">
                <span class="text-muted small me-3" id="footer-stats">
                    <i class="bi bi-database me-1"></i>
                    <span id="footer-video-count">--</span> videos indexed
                </span>
                <a href="/docs" class="text-muted small text-decoration-none me-3">
                    <i class="bi bi-code-slash me-1"></i>API Docs
                </a>
                <a href="/redoc" class="text-muted small text-decoration-none">
                    <i class="bi bi-file-earmark-text me-1"></i>ReDoc
                </a>
            </div>
        </div>
    </div>
</footer>

<script>
    // Fetch stats on page load
    fetch('/api/videos/count')
        .then(res => res.json())
        .then(data => {
            const count = formatNumber(data.count);
            document.getElementById('sidebar-video-count').textContent = count;
            document.getElementById('footer-video-count').textContent = count;
        })
        .catch(() => {
            document.getElementById('sidebar-video-count').textContent = '--';
            document.getElementById('footer-video-count').textContent = '--';
        });
</script>

