{
  "manifest_version": 3,
  "name": "MissAV Video Opener & Ingestor",
  "version": "1.2.1",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": ["https://missav.ws/*", "http://127.0.0.1:9001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://missav.ws/en/search/*"],
      "js": ["content_search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://missav.ws/en/*", "https://missav.ws/dm*/en/*"],
      "js": ["content_single.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Show MissAV Control Panel"
  }
}
