{
  "manifest_version": 3,
  "name": "MissAV Video Opener & Ingestor",
  "version": "1.3.4",
  "permissions": ["tabs", "activeTab", "storage", "scripting"],
  "host_permissions": ["https://missav.ws/*", "http://127.0.0.1:9001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://missav.ws/*"],
      "js": ["content_search.js", "content_single.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Show MissAV Control Panel"
  }
}
