{
  "manifest_version": 3,
  "name": "AniWave Schedule Extractor",
  "version": "2.1",
  "description": "Extract and cache anime schedules with favorites tracking",
  "permissions": ["storage"],
  "host_permissions": ["https://aniwaves.ru/*"],
  "content_scripts": [
    {
      "matches": ["https://aniwaves.ru/home*"],
      "js": [
        "modules/storage.js",
        "modules/extractor.js",
        "modules/navigation.js",
        "modules/automation.js",
        "modules/tracker.js", // NEW
        "modules/favorites-ui.js", // NEW
        "modules/panel.js",
        "content.js"
      ],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
