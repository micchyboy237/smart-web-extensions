{
  "manifest_version": 3,
  "name": "AniWave Schedule Extractor",
  "version": "1.0.0",
  "description": "Extract and cache anime schedules from AniWave with in-page panel",
  "permissions": ["storage"],
  "host_permissions": ["https://aniwaves.ru/*"],
  "content_scripts": [
    {
      "matches": ["https://aniwaves.ru/home*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
