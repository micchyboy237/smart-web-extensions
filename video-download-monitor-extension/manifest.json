{
  "manifest_version": 3,
  "name": "Video Download Monitor & Cache Manager",
  "version": "2.0.4",
  "description": "Floating panel for video monitoring, caching, and offline playback.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Toggle Video Monitor Panel"
  }
}
