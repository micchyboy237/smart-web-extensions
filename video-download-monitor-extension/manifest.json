{
  "manifest_version": 3,
  "name": "Video Download Monitor & Cache Manager",
  "version": "1.0",
  "description": "Monitor video downloads, cancel fetches, manage cache, and enable offline playback.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
