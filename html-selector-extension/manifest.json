{
  "manifest_version": 3,
  "name": "DOM Selector & RAG Cleaner",
  "version": "3.2.0",
  "description": "Pick multiple elements, clean HTML for RAG, preview & send to endpoint — from a detached panel window",
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Toggle RAG Selector panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/dompurify.min.js",
        "lib/readability.min.js",
        "content/cleaner.js",
        "content/prettify.js",
        "content/picker.js",
        "content/index.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
